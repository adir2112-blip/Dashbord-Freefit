{
  "manifest_version": 3,
  "name": "FreeFit Seyata + 3CX Sync",
  "version": "4.5",
  "description": "\u05de\u05e1\u05e0\u05db\u05e8\u05df \u05de\u05db\u05d9\u05e8\u05d5\u05ea \u05de-Seyata \u05d5\u05e9\u05d9\u05d7\u05d5\u05ea \u05de-3CX \u05dc\u05d3\u05e9\u05d1\u05d5\u05e8\u05d3 FreeFit",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://syatacrm.co.il/*",
    "https://movement.3cx.eu/*",
    "https://fmejfxejsrmjvexfizgj.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://syatacrm.co.il/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://movement.3cx.eu/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png"
    }
  },
  "icons": {
    "48": "icon.png"
  }
}